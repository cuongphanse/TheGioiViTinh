@model IEnumerable<Product>
<section class="position-relative overflow-hidden" style="background: #191414;">

    <div class="position-absolute top-0 end-0 bottom-0 d-none d-lg-block"
         style="width: 45%;
        background: linear-gradient(160deg, #1DB954, #17A34A);
        clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);">
    </div>

    <div class="container position-relative py-5" style="z-index: 2;">

        <div class="row align-items-center g-5">

            <!-- LEFT -->

            <div class="col-lg-6 text-center text-lg-start">

                <p class="text-uppercase small fw-semibold mb-3"
                   style="color: #1DB954;
                    letter-spacing: 0.25em;
                    font-size: 0.75rem;">

                    <i class="bi bi-lightning-charge-fill me-1"></i>

                    Cửa Hàng Công Nghệ Hàng Đầu
                </p>

                <h1 class="display-4 fw-bold text-white lh-sm mb-4">

                    Công nghệ hiện đại <br class="d-none d-sm-block" />

                    cho cuộc sống <span style="color: #1DB954;">đỉnh cao.</span>
                </h1>

                <p class="lead mb-4"
                   style="color: #94a3b8;
                    max-width: 500px;">

                    Laptop, PC Gaming, điện thoại và phụ kiện chính hãng
                    với giá tốt nhất dành cho bạn.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-5">

                    <a href="#catalog"
                       class="btn btn-lg btn-success fw-bold rounded-pill px-4">

                        Khám Phá Ngay

                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>

                    <a href="#catalog"
                       class="btn btn-lg btn-outline-success rounded-pill px-4">

                        <i class="bi bi-grid me-1"></i>

                        Danh Mục Sản Phẩm
                    </a>

                </div>

                <!-- STATS -->

                <div class="row g-4 text-center text-lg-start"
                     style="max-width: 420px;">

                    <div class="col-4">

                        <p class="fs-4 fw-bold text-white mb-0">
                            500+
                        </p>

                        <p class="text-uppercase mb-0"
                           style="font-size: 0.65rem;
                            color: #64748b;
                            letter-spacing: 0.1em;">

                            Sản Phẩm
                        </p>
                    </div>

                    <div class="col-4 border-start"
                         style="border-color:
                        rgba(255,255,255,0.1) !important;">

                        <p class="fs-4 fw-bold text-white mb-0">
                            20+
                        </p>

                        <p class="text-uppercase mb-0"
                           style="font-size: 0.65rem;
                            color: #64748b;
                            letter-spacing: 0.1em;">

                            Thương Hiệu
                        </p>
                    </div>

                    <div class="col-4 border-start"
                         style="border-color:
                        rgba(255,255,255,0.1) !important;">

                        <p class="fs-4 fw-bold text-white mb-0">

                            4.9

                            <i class="bi bi-star-fill small"
                               style="color: #1DB954;"></i>
                        </p>

                        <p class="text-uppercase mb-0"
                           style="font-size: 0.65rem;
                            color: #64748b;
                            letter-spacing: 0.1em;">

                            Đánh Giá
                        </p>
                    </div>

                </div>

            </div>

            <!-- RIGHT -->

            <div class="col-lg-6 d-none d-lg-block"
                 style="z-index: 2;">

                <div class="position-relative d-flex align-items-center justify-content-center"
                     style="height: 460px;">

                    <!-- LEFT CARD -->

                    <div class="position-absolute"
                         style="left: 40px;
                        transform: rotate(-8deg) translateY(20px);
                        z-index: 1;
                        opacity: 0.7;">

                        <div class="rounded-4 shadow overflow-hidden"
                             style="width: 170px;
                            height: 250px;
                            background: #1e293b;">

                            <div class="w-100 h-100 d-flex align-items-center justify-content-center">

                                <i class="bi bi-laptop display-4"
                                   style="color: #64748b;"></i>
                            </div>

                        </div>

                    </div>

                    <!-- CENTER -->

                    <div class="position-relative"
                         style="z-index: 3;">

                        <div class="rounded-4 overflow-hidden shadow-lg"
                             style="width: 260px;
                            height: 360px;
                            background: #1e293b;">

                            <div class="w-100 h-100 d-flex align-items-center justify-content-center">

                                <i class="bi bi-pc-display display-1"
                                   style="color: #64748b;"></i>

                            </div>

                        </div>

                        <!-- SALE -->

                        <div class="position-absolute top-0 end-0 rounded-3 shadow px-3 py-2"
                             style="transform: translate(20px, -12px);
                            z-index: 10;
                            background: rgba(255,255,255,0.95);">

                            <small class="text-uppercase fw-medium"
                                   style="font-size: 0.6rem;
                                color: #64748b;">

                                Giảm đến
                            </small>

                            <span class="fw-bold fs-5 ms-1"
                                  style="color: #17A34A;">

                                50%
                            </span>

                        </div>

                    </div>

                    <!-- RIGHT CARD -->

                    <div class="position-absolute"
                         style="right: 40px;
                        transform: rotate(8deg) translateY(20px);
                        z-index: 1;
                        opacity: 0.7;">

                        <div class="rounded-4 shadow overflow-hidden"
                             style="width: 170px;
                            height: 250px;
                            background: #1e293b;">

                            <div class="w-100 h-100 d-flex align-items-center justify-content-center">

                                <i class="bi bi-phone display-4"
                                   style="color: #64748b;"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- WAVE -->

    <div class="position-absolute bottom-0 start-0 end-0"
         style="line-height: 0;">

        <svg viewBox="0 0 1440 60"
             preserveAspectRatio="none"
             style="width: 100%;
            height: 40px;">

            <path d="M0,60 L0,20 Q360,0 720,30 Q1080,60 1440,10 L1440,60 Z"
                  fill="#f5f5f5">

            </path>

        </svg>

    </div>

</section>

<!-- PRODUCT SECTION -->

<div class="container py-5" id="catalog">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Sản Phẩm Nổi Bật
        </h2>

        <p class="text-secondary mb-0">
            Khám phá các thiết bị công nghệ mới nhất
        </p>

    </div>

    <!-- GRID -->
    @if (Model.Any())
    {

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

            <!-- PRODUCT CARD -->
            @foreach(var item in Model)
            {             
                <div class="col">

                    <div class="card h-100 border shadow-sm product-card">

                        <a href="#" class="text-decoration-none">

                            <div style="aspect-ratio: 1/1;
                                overflow: hidden;">
                                @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                {
                                    <img src="@item.MainImageUrl"
                                         alt="@item.Name"
                                         class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">

                                        <i class="bi bi-laptop display-3 text-secondary"></i>

                                    </div>
                                }
                                

                            </div>

                        </a>

                        <div class="card-body">

                            <span class="badge bg-dark mb-2">
                                @item.Brand.Name
                            </span>

                            <h6 class="card-title fw-semibold mb-2"
                                style="min-height: 2.5rem;">

                                <a href="#"
                                   class="text-decoration-none text-dark">

                                    @item.Name
                                </a>

                            </h6>

                            <p class="text-secondary small mb-2">
                                @item.CPU • @item.RAM
                            </p>

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    @if (item.FinalPrice < item.Price)
                                    {
                                        <span class="fw-bold text-success">
                                            @item.FinalPrice.ToString("#,##")đ
                                        </span>

                                        <small class="text-decoration-line-through text-muted ms-1">
                                            @item.Price.ToString("#,##")đ
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-success">
                                            @item.Price.ToString("#,##")đ
                                        </span>
                                    }

                                </div>

                                <a asp-area="Customer" asp-controller="Home" asp-action="Detail" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-dark">

                                    Xem
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    }

</div>

<!-- NEWSLETTER -->

<section class="py-5"
         style="background:
    linear-gradient(135deg,
    #065f46 0%,
    #191414 100%);">

    <div class="container">

        <div class="row justify-content-center text-center text-white">

            <div class="col-lg-8">

                <i class="bi bi-envelope-heart display-4 mb-3"></i>

                <h3 class="fw-bold mb-3">
                    Nhận Thông Tin Khuyến Mãi
                </h3>

                <p class="lead mb-4"
                   style="color: #94a3b8;">

                    Đăng ký để nhận ưu đãi mới nhất
                    và cập nhật sản phẩm công nghệ mới.
                </p>

                <form class="row g-2 justify-content-center">

                    <div class="col-md-6">

                        <input type="email"
                               name="email"
                               class="form-control form-control-lg"
                               placeholder="Nhập email của bạn"
                               required />

                    </div>

                    <div class="col-md-auto">

                        <button type="submit"
                                class="btn btn-accent btn-lg px-4">

                            Đăng Ký
                        </button>

                    </div>

                </form>

                <p class="small mt-3 mb-0"
                   style="color: #94a3b8;">

                    <i class="bi bi-shield-check me-1"></i>

                    Chúng tôi cam kết bảo mật thông tin của bạn
                </p>

            </div>

        </div>

    </div>

</section>