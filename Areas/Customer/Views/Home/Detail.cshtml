@model ShoppingCart

<div class="container pt-2 pb-5">

    <div class="mb-3">

        <a asp-action="Index"
           class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1">

            <i class="bi bi-arrow-left"></i>
            Quay lại sản phẩm
        </a>

    </div>

    <div class="card border-0 shadow-lg overflow-hidden rounded-4">

        <div class="row g-0">

            <!-- IMAGE SECTION -->

            <div class="col-lg-5">

                <div class="h-100 p-4"
                     style="background: linear-gradient(135deg,#111827,#1f2937,#374151);">

                    <!-- MAIN IMAGE -->

                    <div class="rounded-4 overflow-hidden bg-white shadow-sm mb-3">

                        @if (!string.IsNullOrEmpty(Model.Product.MainImageUrl))
                        {
                            <img src="@Model.Product.MainImageUrl"
                                 class="w-100"
                                 style="height: 420px; object-fit: cover;"
                                 alt="@Model.Product.Name" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center"
                                 style="height:420px;">

                                <i class="bi bi-phone"
                                   style="font-size:6rem;color:#9ca3af;"></i>

                                <p class="text-secondary mt-3 mb-0">
                                    Không có ảnh
                                </p>

                            </div>
                        }

                    </div>

                    <!-- SUB IMAGES -->
                    @if (Model.Product.ProductImages != null
                                        && Model.Product.ProductImages.Any())
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="border rounded-3 overflow-hidden bg-white shadow-sm"
                                 style="width:90px;height:90px;cursor:pointer;">

                                <img src="@Model.Product.MainImageUrl"
                                     class="w-100 h-100"
                                     style="object-fit:cover;"
                                     onclick="changeMainImage(this)" />

                            </div>
                            @foreach (var image in Model.Product.ProductImages)
                            {
                                <div class="border rounded-3 overflow-hidden bg-white shadow-sm"
                                     style="width:90px;height:90px;cursor:pointer;">

                                    <img src="@image.ImageUrl"
                                         class="w-100 h-100"
                                         style="object-fit:cover;"
                                         onclick="changeMainImage(this)" />

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

            <!-- DETAIL SECTION -->

            <div class="col-lg-7">

                <div class="p-4 p-lg-5">

                    <!-- CATEGORY -->

                    <div class="mb-3">

                        <span class="badge px-3 py-2 rounded-pill"
                              style="background: rgba(29,185,84,.1);
                            color:#1DB954;">

                            <i class="bi bi-grid me-1"></i>

                            @Model.Product.Category?.Name
                        </span>

                    </div>

                    <!-- PRODUCT NAME -->

                    <h1 class="fw-bold mb-2"
                        style="font-size:2rem; color:#111827;">

                        @Model.Product.Name
                    </h1>

                    <!-- BRAND -->

                    <p class="text-secondary mb-4">

                        Thương hiệu:
                        <span class="fw-semibold text-dark">
                            @Model.Product.Brand?.Name
                        </span>

                    </p>

                    <!-- PRICE -->

                    <div class="d-flex align-items-center gap-3 mb-4">
                        @if(Model.Product.FinalPrice < Model.Product.Price)
                        {
                            <span class="fw-bold"
                                  style="font-size:2rem; color:#16a34a;">

                                @Model.Product.FinalPrice.ToString("N0") ₫
                            </span>
                            <span class="fw-bold text-decoration-line-through text-secondary"
                                  style="font-size:1.5rem; ">

                                @Model.Product.Price.ToString("N0") ₫
                            </span>
                        }
                        else
                        {                          
                            <span class="fw-bold"
                                  style="font-size:2rem; color:#16a34a;">

                                @Model.Product.Price.ToString("N0") ₫
                            </span>
                        }

                    </div>

                    <!-- STOCK -->

                    <div class="mb-4">

                        @if (Model.Product.StockQuantity > 0)
                        {
                            <span class="badge bg-success-subtle text-success border px-3 py-2">

                                <i class="bi bi-check-circle me-1"></i>
                                Còn hàng (@Model.Product.StockQuantity)

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border px-3 py-2">

                                <i class="bi bi-x-circle me-1"></i>
                                Hết hàng

                            </span>
                        }

                    </div>

                    <!-- TECHNICAL SPECS -->

                    <div class="border rounded-4 p-4 mb-4 bg-light">

                        <h6 class="fw-bold mb-4">

                            <i class="bi bi-cpu me-2 text-success"></i>
                            Thông số kỹ thuật

                        </h6>

                        <div class="row g-3">

                            @if (!string.IsNullOrEmpty(Model.Product.CPU))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            CPU
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.CPU
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Product.RAM))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            RAM
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.RAM
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Product.Storage))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            Ổ cứng
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.Storage
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Product.GPU))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            Card đồ họa
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.GPU
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Product.Color))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            Màu sắc
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.Color
                                        </span>
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Product.Weight))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 bg-white h-100">
                                        <small class="text-secondary d-block mb-1">
                                            Cân nặng
                                        </small>
                                        <span class="fw-semibold">
                                            @Model.Product.Weight
                                        </span>
                                    </div>
                                </div>
                            }

                        </div>

                    </div>

                    <!-- DESCRIPTION -->
                    @if (!string.IsNullOrEmpty(Model.Product.Description))
                    {
                        <div class="mb-4 overflow-scroll" style="height: 300px">

                            <h6 class="fw-bold mb-3">

                                <i class="bi bi-card-text me-2 text-success"></i>
                                Mô tả sản phẩm

                            </h6>

                            <div class="text-secondary lh-lg">

                                @Html.Raw(Model.Product.Description)

                            </div>

                        </div>
                    }

                    <!-- ADD TO CART -->

                    <form method="post">

                        <input asp-for="ProductId" type="hidden" />

                        <div class="d-flex gap-3">

                            <div class="input-group"
                                 style="width:140px;">

                                <span class="input-group-text bg-success text-white border-success">

                                    SL

                                </span>

                                <input type="number" asp-for="Count" min="1"
                                       class="form-control text-center fw-semibold" />

                            </div>

                            <button type="submit"
                                    class="btn btn-success flex-grow-1 fw-semibold">

                                <i class="bi bi-cart-plus me-2"></i>
                                Thêm vào giỏ hàng

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        function changeMainImage(element) {

            const mainImage =
                document.querySelector('.col-lg-5 img');

            mainImage.src = element.src;
        }

    </script>

}