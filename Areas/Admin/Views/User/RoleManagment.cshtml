@model RoleManagmentVM

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <a asp-action="Index"
               class="d-inline-flex align-items-center gap-2 text-secondary mb-4 text-decoration-none">

                <i class="bi bi-arrow-left"></i>
                Quay lại danh sách người dùng

            </a>

            <div class="card border shadow-sm overflow-hidden">

                <div class="card-header text-white py-4"
                     style="background: linear-gradient(135deg, #065f46 0%, #191414 100%);">

                    <h4 class="mb-1 fw-bold">

                        <i class="bi bi-shield-check me-2"></i>
                        Quản lý vai trò người dùng

                    </h4>

                    <p class="mb-0 small opacity-75">

                        Phân quyền và quản lý quyền truy cập cho người dùng

                    </p>

                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <input hidden asp-for="ApplicationUser.Id" />


                        <div class="alert alert-light border mb-4">

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label class="small text-secondary fw-semibold mb-1">

                                        Họ và tên

                                    </label>

                                    <p class="mb-0 fw-semibold">

                                        @Model.ApplicationUser.Name

                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <label class="small text-secondary fw-semibold mb-1">

                                        Email

                                    </label>

                                    <p class="mb-0 fw-semibold">

                                        @Model.ApplicationUser.Email

                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <label class="small text-secondary fw-semibold mb-1">

                                        Số điện thoại

                                    </label>

                                    <p class="mb-0">

                                        @(string.IsNullOrEmpty(Model.ApplicationUser.PhoneNumber)
                                            ? "Không có"
                                            : Model.ApplicationUser.PhoneNumber)

                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <label class="small text-secondary fw-semibold mb-1">

                                        Vai trò hiện tại

                                    </label>

                                    <p class="mb-0">

                                        <span class="badge bg-secondary">

                                            @Model.ApplicationUser.Role

                                        </span>

                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                <i class="bi bi-person-badge me-1 text-secondary"></i>
                                Gán vai trò mới

                            </label>

                            <select asp-for="ApplicationUser.Role"
                                    asp-items="@Model.RoleList"
                                    class="form-select form-select-lg">

                                <option disabled selected>

                                    -- Chọn vai trò --

                                </option>

                            </select>

                            <div class="form-text">

                                <i class="bi bi-info-circle me-1"></i>
                                Chọn vai trò phù hợp cho người dùng

                            </div>

                        </div>


                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body p-3">

                                <p class="small fw-semibold mb-2 text-secondary">

                                    <i class="bi bi-question-circle me-1"></i>
                                    Mô tả vai trò:

                                </p>

                                <ul class="small mb-0 text-secondary"
                                    style="line-height: 1.8;">

                                    <li>

                                        <strong>Khách hàng:</strong>
                                        Có thể xem và mua sản phẩm

                                    </li>

                                    <li>

                                        <strong>Nhân viên:</strong>
                                        Có thể quản lý đơn hàng và sản phẩm

                                    </li>

                                    <li>

                                        <strong>Quản trị viên:</strong>
                                        Toàn quyền quản trị hệ thống và người dùng

                                    </li>

                                </ul>

                            </div>

                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Hủy

                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4">

                                <i class="bi bi-check-circle me-1"></i>
                                Cập nhật vai trò

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>