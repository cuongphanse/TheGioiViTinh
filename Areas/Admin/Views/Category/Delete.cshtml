@model Category
<div class="container-fluid">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>

    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Xóa Danh Mục</h5>
            @* <p class="mb-0 small" style="color: #1DB954;">Thêm một danh mục mới cho sản phẩm của bạn</p> *@
        </div>

        <div class="card-body p-4">
            <form method="post" asp-action="Delete">
                <input asp-for="Id" hidden />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small">Tên Danh Mục</label>
                    <input asp-for="Name" readonly class="form-control" placeholder="Nhập tên danh mục..." />
  
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small">Thứ Tự Hiển Thị</label>
                    <input asp-for="DisplayOrder" readonly class="form-control" placeholder="Nhập thứ tự hiển thị..." />

                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-semibold">Xóa danh mục</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}