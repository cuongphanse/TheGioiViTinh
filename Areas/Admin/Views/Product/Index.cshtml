<div class="container-fluid">

    <div class="card border shadow-sm overflow-hidden">

        <!-- Header -->

        <div class="card-header text-white py-3 px-4 d-flex justify-content-between align-items-center"
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

            <div>

                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-laptop me-2"></i>
                    Sản Phẩm
                </h5>

                <p class="mb-0 small"
                   style="color:#1DB954;">

                    Quản lý sản phẩm hệ thống
                </p>

            </div>

            <a asp-action="Create"
               class="btn btn-sm btn-outline-light fw-semibold">

                <i class="bi bi-plus-lg"></i>
                Thêm Sản Phẩm
            </a>

        </div>

        <!-- Body -->

        <div class="card-body">

            <div class="table-responsive">

                <table id="tblData"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">

                        <tr>

                            <th>Ảnh</th>

                            <th>Tên</th>

                            <th>Danh mục</th>

                            <th>Thương hiệu</th>

                            <th>Giá</th>

                            <th>Tồn kho</th>

                            <th class="text-end">
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="/js/product.js" asp-append-version="true"></script>

}