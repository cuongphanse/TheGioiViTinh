@model IEnumerable<TheGioiViTinh.Models.Entities.Discount>

<div class="container-fluid">

    <div class="card border shadow-sm overflow-hidden">

        <!-- HEADER -->

        <div class="card-header text-white py-3 px-4 d-flex justify-content-between align-items-center"
             style="background: linear-gradient(to right, #065f46, #282828, #191414);">

            <div>
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-percent me-2"></i>
                    Danh Sách Khuyến Mãi
                </h5>

                <p class="mb-0 small"
                   style="color: #1DB954;">
                    Quản lý chương trình giảm giá sản phẩm
                </p>
            </div>

            <a asp-action="Create"
               class="btn btn-sm btn-outline-light fw-semibold">

                <i class="bi bi-plus-lg me-1"></i>
                Tạo Khuyến Mãi
            </a>

        </div>

        <!-- BODY -->

        <div class="card-body">

            <table id="tblData"
                   class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Tên chương trình</th>

                        <th>Giảm giá</th>

                        <th>Ngày bắt đầu</th>

                        <th>Ngày kết thúc</th>

                        <th>Trạng thái</th>

                        <th width="15%">Thao tác</th>

                    </tr>

                </thead>

            </table>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/discount.js"></script>
}