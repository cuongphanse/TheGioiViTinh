<aside class="admin-sidebar d-none d-lg-flex flex-column sticky-top"
       style="height:100vh;">

    <div class="p-4 border-bottom border-secondary">
        <a asp-area="Customer"
           asp-controller="Home"
           asp-action="Index"
           class="logo d-flex align-items-center gap-2">

            <img src="/images/PC.jpg"
                 width="36"
                 height="36"
                 class="rounded" />

            <div>
                <div class="fw-bold">
                    ThếGiới<span class="text-success">ViTính</span>
                </div>

                <small class="text-secondary">
                    Trang quản trị
                </small>
            </div>
        </a>
    </div>

    <div class="flex-grow-1 overflow-auto p-3">

        <div class="admin-sidebar-nav">

            <p class="nav-section">Tổng quan</p>

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <p class="nav-section">Quản lý cửa hàng</p>

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-pc-display"></i>
                Sản phẩm
            </a>
            <a asp-area="Admin"
               asp-controller="Order"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-truck"></i>
                Đơn hàng
            </a>
            <a asp-area="Admin"
               asp-controller="Category"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-grid"></i>
                Danh mục
            </a>

            <a asp-area="Admin"
               asp-controller="Brand"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-award"></i>
                Thương hiệu
            </a>

            <a asp-area="Admin"
               asp-controller="Discount"
               asp-action="Index"
               class="nav-link d-flex align-items-center gap-2">
                <i class="bi bi-percent"></i>
                Khuyến mãi
            </a>

            @if (User.IsInRole("Admin"))
            {
                <p class="nav-section">Hệ thống</p>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-people"></i>
                    Người dùng
                </a>
            }
        </div>
    </div>

    <!-- FOOTER -->
    <div class="border-top border-secondary p-3">

        <div class="d-flex align-items-center gap-2 mb-3">

            <i class="bi bi-person-circle text-secondary fs-5"></i>

            <div class="flex-grow-1 overflow-hidden">
                <div class="small text-white text-truncate">
                    @User.Identity?.Name
                </div>

                <small class="text-secondary">
                    @if (User.IsInRole("Admin"))
                    {
                        <span>Quản trị viên</span>
                    }
                    else if (User.IsInRole("Employee"))
                    {
                        <span>Nhân viên</span>
                    }
                </small>
            </div>
        </div>

        <div class="d-flex gap-2">

            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-sm store-btn flex-grow-1">
                <i class="bi bi-shop"></i>
                Cửa hàng
            </a>

            <form method="post"
                  asp-area="Identity"
                  asp-controller="Account"
                  asp-action="Logout">

                <button type="submit"
                        class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>

        </div>
    </div>
</aside>