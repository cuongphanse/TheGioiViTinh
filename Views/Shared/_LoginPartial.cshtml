
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@if (SignInManager.IsSignedIn(User))
{
    <a class="text-white-50 text-decoration-none small fw-medium">
        <i class="bi bi-person-circle px-1"></i>@UserManager.GetUserName(User)
    </a>
    <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="btn btn-outline-success text-white-50 text-decoration-none small fw-medium nav-link-hover">
            Đăng xuất</button>
    </form>
} 
else
{ 
    <a class="text-white-50 text-decoration-none small fw-medium nav-link-hover" asp-area="Identity" asp-controller="Account" asp-action="Register">Đăng ký</a>
    <a class="btn btn-success btn-sm fw-semibold" asp-area="Identity" asp-controller="Account" asp-action="Login">Đăng nhập</a>
}