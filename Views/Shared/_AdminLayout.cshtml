<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThếGiớiViTính Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheGioiViTinh.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css" />

    <style>
            body {
                font-family: 'Inter', system-ui, sans-serif;
                background: #f8fafc;
            }

            .admin-sidebar {
                width: 250px;
                background: #191414;
                border-right: 1px solid rgba(255,255,255,0.08);
            }

                .admin-sidebar .logo {
                    color: white;
                    text-decoration: none;
                }

            .admin-sidebar-nav .nav-link {
                color: #94a3b8;
                font-size: 0.92rem;
                padding: 0.75rem 1rem;
                border-radius: 12px;
                margin-bottom: 4px;
                transition: all .2s ease;
            }

                .admin-sidebar-nav .nav-link:hover {
                    background: rgba(255,255,255,0.06);
                    color: white;
                }

                .admin-sidebar-nav .nav-link.active {
                    background: linear-gradient(135deg,#16a34a,#15803d);
                    color: white;
                    box-shadow: 0 4px 12px rgba(22,163,74,.25);
                }

            .nav-section {
                color: #64748b;
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .08em;
                margin-top: 1rem;
                margin-bottom: .5rem;
                padding-left: .5rem;
                font-weight: 700;
            }

            .admin-topbar {
                background: white;
                border-bottom: 1px solid #e2e8f0;
            }

            .admin-content {
                min-height: 100vh;
                background: #f8fafc;
            }

            .store-btn {
                border: 1px solid rgba(255,255,255,.15);
                color: white;
            }

                .store-btn:hover {
                    background: rgba(255,255,255,.06);
                    color: white;
                }
    </style>
</head>

<body>

    <!-- MOBILE TOPBAR -->
    <div class="d-lg-none sticky-top admin-topbar">
        <div class="d-flex align-items-center justify-content-between px-3 py-2">

            <button class="btn border-0 shadow-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar">
                <i class="bi bi-list fs-3"></i>
            </button>

            <span class="fw-bold">
                ThếGiới<span class="text-success">ViTính</span>
            </span>

            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="btn btn-sm btn-outline-success">
                Store
            </a>
        </div>
    </div>

    <!-- MOBILE SIDEBAR -->
    <div class="offcanvas offcanvas-start text-bg-dark"
         tabindex="-1"
         id="mobileSidebar"
         style="background:#191414">

        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title fw-bold">
                Quản trị viên
            </h5>

            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas">
            </button>
        </div>

        <div class="offcanvas-body">
            <div class="admin-sidebar-nav">

                <p class="nav-section">Tổng quan</p>

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <p class="nav-section">Quản lý cửa hàng</p>

                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-pc-display"></i>
                    Sản phẩm
                </a>

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-grid"></i>
                    Danh mục
                </a>

                <a asp-area="Admin"
                   asp-controller="Brand"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-award"></i>
                    Thương hiệu
                </a>

                <a asp-area="Admin"
                   asp-controller="Discount"
                   asp-action="Index"
                   class="nav-link d-flex align-items-center gap-2">
                    <i class="bi bi-percent"></i>
                    Khuyến mãi
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <p class="nav-section">Hệ thống</p>

                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Index"
                       class="nav-link d-flex align-items-center gap-2">
                        <i class="bi bi-people"></i>
                        Người dùng
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="d-flex">

        <!-- DESKTOP SIDEBAR -->
        <partial name="_AdminSidebarNav" />

        <!-- MAIN -->
        <div class="flex-grow-1 admin-content">

            <div class="admin-topbar d-none d-lg-flex align-items-center justify-content-between px-4 py-3">

                <div>
                    <h5 class="mb-0 fw-bold">
                        @ViewData["Title"]
                    </h5>

                    <small class="text-secondary">
                        Quản lý hệ thống ThếGiớiViTính
                    </small>
                </div>

                <div class="d-flex align-items-center gap-3">

                    <span class="small text-secondary">
                        Xin chào,
                        <span class="fw-semibold text-dark">
                            @User.Identity?.Name
                        </span>
                    </span>

                </div>
            </div>

            <div class="p-4">
                <partial name="_Notification" />
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="//cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>